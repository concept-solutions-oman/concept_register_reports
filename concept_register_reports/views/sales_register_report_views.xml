<odoo>
    <record id="view_sales_register_report_tree" model="ir.ui.view">
        <field name="name">sales.register.report.tree</field>
        <field name="model">sales.register.report</field>
        <field name="arch" type="xml">
            <tree string="Sales Register Report" create="false" edit="false" delete="false">
                <field name="invoice_date"/>
                <field name="invoice_id" widget="many2one_clickable"/>
                <field name="customer_id" widget="many2one_clickable"/>
                <field name="product_id" widget="many2one_clickable"/>
                <field name="quantity"/>
                <field name="price_unit"/>
                <field name="taxable_amount"/>
                <field name="tax_amount"/>
                <field name="total_with_tax"/>
            </tree>
        </field>
    </record>

    <record id="view_sales_register_report_search" model="ir.ui.view">
        <field name="name">sales.register.report.search</field>
        <field name="model">sales.register.report</field>
        <field name="arch" type="xml">
            <search>
                <field name="product_id"/>
                <field name="invoice_number"/>
                <field name="customer_id"/>
                <filter string="Today" name="today" domain="[('invoice_date', '=', context_today())]"/>
                <filter name="yesterday" string="Yesterday" domain="[('invoice_date', '=', (context_today() - relativedelta(days=1)))]"/> 
                <filter name="this_month" string="This Month" domain="[('invoice_date', '&gt;=', context_today().strftime('%Y-%m-01')), ('invoice_date', '&lt;=', context_today())]" />
                
                <separator/>
                <filter name="filter_invoice_date" string="Invoice Date" date="invoice_date"/>
                <group expand="0" string="Group By">
                    <filter name="group_customer" string="Customer" context="{'group_by':'customer_id'}"/>
                    <filter name="group_invoice" string="Invoice" context="{'group_by':'invoice_id'}"/>
                    <filter name="group_product" string="Product" context="{'group_by':'product_id'}"/>
                    <filter name="group_by_invoice_date" string="Invoice Date" context="{'group_by': 'invoice_date'}"/>
                    <filter string="Company" name="group_company" context="{'group_by': 'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sales_register_report" model="ir.actions.act_window">
        <field name="name">Sales Register Report</field>
        <field name="res_model">sales.register.report</field>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="view_sales_register_report_tree"/>
        <field name="search_view_id" ref="view_sales_register_report_search"/>
        <field name="context">{'group_by':'invoice_id'}</field>
        <field name="domain">[('company_id', 'in', context.get('allowed_company_ids', []))]</field>
    </record>
    <menuitem id="menu_purchase_register_root"
          name="Purchase Register"
          parent="concept_account_reports.menu_concept_account_root"
          sequence="10" />
    <menuitem id="menu_sales_register_report"
          name="Sales Register Report"
          parent="menu_purchase_register_root"
          action="action_sales_register_report" />


</odoo>
